(1 row)

-- ===========================================================================
-- (8) Bare-leaf multi-field membership (closes the Task 7 review non-issue):
-- term/wildcard scoped to ONE field, bare (no boolean wrapper), BOTH the @@@
-- filter and the single-key &@@ scored form -- assert field scope is correct
-- AND filter == scored.
-- ===========================================================================
SELECT array_agg(id ORDER BY id) AS filter_set FROM acc WHERE title @@@ bm25_term('title','tort');   -- expect {1,3,5,8,15,18}
   filter_set    
-----------------
 {1,3,5,8,15,18}
(1 row)

