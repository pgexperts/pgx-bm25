     = (SELECT array_agg(id ORDER BY id) FROM (SELECT id FROM acc WHERE title @@@ bm25_term('title','tort') ORDER BY title &@@ bm25_term('title','tort'), id) s)
  AS bare_term_title_filter_eq_scored;
 bare_term_title_filter_eq_scored 
----------------------------------
