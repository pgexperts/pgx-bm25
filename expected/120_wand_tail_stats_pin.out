DROP VIEW verdict;
DROP FUNCTION tail_run(text, text, int, text, bool);
DROP FUNCTION take_ref(text, text);
DROP FUNCTION mt_words(int, int);
DROP TABLE got, ref, a, b, c, t, m, mt;
DROP EXTENSION bm25_native;
