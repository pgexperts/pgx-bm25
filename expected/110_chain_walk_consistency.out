(1 row)

SELECT pg_temp.err_of($q$SELECT count(*) FROM sc_docs WHERE body @@@ 'alpha'$q$)
       AS scan_one_past_end;
                 scan_one_past_end                  
----------------------------------------------------
 XX002 bm25: segment catalog chain leaves the index
(1 row)

SELECT pg_temp.err_of($q$SELECT count(*) FROM bm25_debug_segcat('sc_bm')$q$)
       AS segcat_read_one_past_end;
              segcat_read_one_past_end              
