DROP TABLE dl_docs;
-- ============================================ 2. KEYMAP: extent bound + reader cursor
-- bm25_seg_key walked the KEYMAP chain from its root on every call with no extent
-- bound, and it was called once per ranked row (both ranking builders, each also
-- re-reading the row's segment header) and once per document in the merge. Its comment
-- declined the bound on the cost of a per-call RelationGetNumberOfBlocks -- the
-- argument ADR 0095 answered for the other dense chains by capturing the extent once
-- per reader. KEYMAP now has a cursor in BM25SegReader (bm25_seg_reader_key); the merge
-- uses its per-source reader, the ranking builders a per-segment reader cache, and the
-- walk raises ERRCODE_INDEX_CORRUPTED on an out-of-extent link.
--
-- int8 keys are 8 bytes, so 3000 documents span three KEYMAP pages per segment.
-- ---- 2a. the answers do not change
-- Four segments, so a ranked row's winning segment varies row to row and the ranking
-- builders' per-segment reader cache is exercised across segments, not just within one;
-- and four of one size, because that is what bm25_merge needs to merge them
-- (BM25_MERGE_LAYER_FANOUT).
-- Scores depend on length (13 distinct lengths), so a key resolved from the wrong
-- document -- or from the wrong segment's reader -- makes bm25_score_key(id) return
-- another document's score, or NULL.
CREATE TABLE kk (id bigint primary key, body text);
CREATE INDEX kk_bm ON kk USING bm25_native (body) INCLUDE (id) WITH (key_field = 'id');
DO $$
DECLARE k int;
BEGIN
  FOR k IN 0..3 LOOP
    INSERT INTO kk SELECT g, 'common ' || repeat('pad ', (g % 13)::int)
      FROM generate_series(k * 3000 + 1, k * 3000 + 3000) g;
    PERFORM bm25_seal('kk_bm');
  END LOOP;
END $$;
SELECT count(*) AS kk_segments FROM bm25_debug_segcat('kk_bm');
 kk_segments 
-------------
           4
(1 row)

-- Every ranked row's key-path score equals its ctid-path score, under both builders.
-- The ctid path does not touch the KEYMAP, so it is the independent side.
SET enable_seqscan = off;
CREATE FUNCTION pg_temp.key_vs_ctid() RETURNS TABLE
    (ranked bigint, key_resolved bigint, key_eq_ctid bigint) AS $$
    SELECT count(*), count(by_key),
           count(*) FILTER (WHERE by_key = by_ctid)
    FROM (SELECT bm25_score(ctid) AS by_ctid, bm25_score_key(id) AS by_key
            FROM kk WHERE body @@@ 'common' ORDER BY body &@@ 'common' LIMIT 12000) q;
$$ LANGUAGE sql;
SET bm25_native.wand_top_k = 20000;
SELECT * FROM pg_temp.key_vs_ctid();        -- WAND builder
 ranked | key_resolved | key_eq_ctid 
--------+--------------+-------------
  12000 |        12000 |       12000
(1 row)

SET bm25_native.wand_top_k = 0;
SELECT * FROM pg_temp.key_vs_ctid();        -- exhaustive builder
 ranked | key_resolved | key_eq_ctid 
--------+--------------+-------------
  12000 |        12000 |       12000
(1 row)

RESET bm25_native.wand_top_k;
-- Differential on one segment: ONE reader carried across the docid list against
-- bm25_seg_key called fresh per docid (a root walk each time, the pre-fix path), and
-- both against the row's own id, joined through its TID. Descending and scattered
-- orders drive the cursor's backward-jump fallback.
CREATE FUNCTION pg_temp.key_diff(seg int, docids int[]) RETURNS TABLE
    (rows bigint, reader_eq_oneshot bigint, reader_eq_heap bigint) AS $$
    SELECT count(*),
           count(*) FILTER (WHERE r.reader_bytes = r.oneshot_bytes),
           count(*) FILTER (WHERE r.reader_int = d.id)
    FROM bm25_debug_seg_reader_diff('kk_bm', seg, 'key', docids) r
    JOIN kk d ON d.ctid = r.tid;
$$ LANGUAGE sql;
SELECT * FROM pg_temp.key_diff(1, ARRAY(SELECT generate_series(0, 2999)));
 rows | reader_eq_oneshot | reader_eq_heap 
------+-------------------+----------------
 3000 |              3000 |           3000
(1 row)

SELECT * FROM pg_temp.key_diff(1, ARRAY(SELECT generate_series(2999, 0, -1)));
 rows | reader_eq_oneshot | reader_eq_heap 
------+-------------------+----------------
 3000 |              3000 |           3000
(1 row)

SELECT * FROM pg_temp.key_diff(1,
    ARRAY(SELECT d FROM generate_series(0, 2999) d ORDER BY hashint4(d), d));
 rows | reader_eq_oneshot | reader_eq_heap 
------+-------------------+----------------
 3000 |              3000 |           3000
(1 row)

-- Chain identity: a reader's KEYMAP cursor parked on segment 0, then used for segment
-- 1. The resume test's root clause must send the lookup back to segment 1's own root;
-- without it the walk resumes on segment 0's page. Compared with segment 1's key read
-- the one-shot way, at a docid on each of its three KEYMAP pages.
SELECT bool_and(bm25_debug_keymap_cursor_crosstalk('kk_bm', 0, 1, d) =
                (SELECT oneshot_bytes FROM bm25_debug_seg_reader_diff('kk_bm', 1, 'key',
                                                                      ARRAY[d::int])))
       AS keymap_crosstalk_reads_own_chain
  FROM (VALUES (0), (1500), (2999)) v(d);
 keymap_crosstalk_reads_own_chain 
----------------------------------
