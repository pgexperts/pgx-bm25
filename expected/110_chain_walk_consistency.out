(1 row)

-- Every scan starts with bm25_scan_snapshot, so an ordinary query is the real path.
-- Pre-fix this raised the buffer manager's own error for block 4294967294.
SET enable_seqscan = off;
SELECT pg_temp.err_of($q$SELECT count(*) FROM sc_docs WHERE body @@@ 'alpha'$q$)
       AS scan_past_extent;
