-- ---- 2b. an out-of-extent KEYMAP link raises, naming the chain
-- Four segments of 1500 documents -- two KEYMAP pages each -- so bm25_merge takes all
-- four, the corrupted one among them.
CREATE TABLE kf (id bigint primary key, body text);
CREATE INDEX kf_bm ON kf USING bm25_native (body) INCLUDE (id) WITH (key_field = 'id');
DO $$
DECLARE k int;
BEGIN
  FOR k IN 0..3 LOOP
    INSERT INTO kf SELECT g, 'common word' || g
      FROM generate_series(k * 1500 + 1, k * 1500 + 1500) g;
    PERFORM bm25_seal('kf_bm');
  END LOOP;
END $$;
\set VERBOSITY terse
SELECT bm25_debug_stamp_chain_next('kf_bm', 'keymap', -1, 0, 1);
ERROR:  bm25_debug_stamp_chain_next: seg -1 is negative
SELECT bm25_debug_stamp_chain_next('kf_bm', 'keymap', 4, 0, 1);
ERROR:  bm25: segment 4 out of range (4 live)
SELECT bm25_debug_stamp_chain_next('kf_bm', 'keymap', 0, 2, 1);
ERROR:  bm25_debug_stamp_chain_next: keymap chain has only 2 page(s)
\set VERBOSITY default
-- The link out of segment 0's first KEYMAP page. Every document past the first page
-- needs it, so a ranked query over all 6000 rows reaches it through the ranking
-- builder's reader cache, and the other paths reach it through their own readers.
SELECT bm25_debug_stamp_chain_next('kf_bm', 'keymap', 0, 0, 4294967294) > 0
       AS stamped_keymap_page;
