-- 110_chain_walk_consistency -- issue #225, the three chain walks ADR 0095 left out of
-- scope: the SEGCAT walkers' missing extent bound, bm25_seg_key's per-row KEYMAP
-- re-walk (also unbounded), and bm25_debug_postings' per-posting NORMS re-walk.
CREATE EXTENSION bm25_native;
-- A shared error renderer. SQLSTATE is pinned alongside the message because "some
-- corruption error" is exactly what the pre-fix behaviour also produced -- the change
-- is WHICH error. Block numbers are stripped: they depend on BLCKSZ and on how many
-- pages this build happened to write.
CREATE FUNCTION pg_temp.err_of(q text) RETURNS text AS $$
BEGIN
    EXECUTE q;
    RETURN 'NO ERROR RAISED';
EXCEPTION WHEN OTHERS THEN
    RETURN SQLSTATE || ' ' || regexp_replace(SQLERRM, 'block [0-9]+', 'block N');
END; $$ LANGUAGE plpgsql;
-- ===================================================== 1. SEGCAT extent bound
-- bm25_scan_snapshot and bm25_segcat_read walked the catalog chain bounded only by an
-- entry COUNT (`filled < nsegs`), which constrains how many entries are copied and
-- nothing about where nextblk points. An out-of-extent link reached ReadBuffer and
-- surfaced as the buffer manager's short-read error -- a file and a block, no bm25
-- structure named, and a different SQLSTATE depending on how far past the end it
-- pointed. They now raise ERRCODE_INDEX_CORRUPTED naming the chain, like the four
-- walkers ADR 0095 bounded.
--
-- A two-page catalog, so a mid-chain link exists to corrupt. A catalog page holds 203
-- entries and the seal PREPENDS a fresh root when the current one is full, so after
-- 210 one-row seals the root carries the last 7 entries and links to the full page.
CREATE TABLE sc_docs (id int primary key, body text);
CREATE INDEX sc_bm ON sc_docs USING bm25_native (body);
DO $$
BEGIN
  FOR i IN 1..210 LOOP
    INSERT INTO sc_docs VALUES (i, 'alpha doc' || i);
    PERFORM bm25_seal('sc_bm');
  END LOOP;
END $$;
-- Negative control first, so a bound that rejected everything could not pass below.
-- nblocks = -1 runs each walker's public entry point, which samples for itself.
-- find_entry and locate_entry look up the catalog's LAST entry, so they cross both
-- pages too.
SELECT bm25_debug_segcat_walk('sc_bm', 'scan_snapshot', -1) AS snapshot_entries,
       bm25_debug_segcat_walk('sc_bm', 'segcat_read',   -1) AS read_entries,
       bm25_debug_segcat_walk('sc_bm', 'find_entry',    -1) AS find_found,
       bm25_debug_segcat_walk('sc_bm', 'locate_entry',  -1) AS locate_found,
       bm25_debug_segcat_walk('sc_bm', 'first_entry',   -1) AS first_found;
 snapshot_entries | read_entries | find_found | locate_found | first_found 
------------------+--------------+------------+--------------+-------------
              210 |          210 |          1 |            1 |           1
(1 row)

-- The pre-lock sample. All five walkers must sample the extent BEFORE they read
-- segcat_root (bm25_scan_snapshot reads it under the metapage SHARE and walks under
-- it), and a seal or merge can extend the relation for a fresh catalog page and flip
-- segcat_root to it between that sample and the root read. The walker is then handed a
-- HEALTHY root at or past its own sample. No suite can land a concurrent seal in that
-- window, but the race only changes the sample's value, so the probe substitutes one:
-- 1 is the metapage alone, which puts the root (and every other catalog page) past
-- the sample, and 0 is staler still. A healthy catalog must read back in full -- the
-- walkers re-sample the extent before they call a link corrupt. Without the re-sample
-- the undamaged index fails every walker here, each in its own way: scan_snapshot and
-- segcat_read raise "segment catalog chain leaves the index", find_entry reports the
-- gen absent, and locate_entry raises "segment header N not found in catalog".
-- first_entry (issue #270, the INSERT key check's root read) samples the same way and
-- would raise "segment catalog chain leaves the index" on the root.
SELECT bm25_debug_segcat_walk('sc_bm', 'scan_snapshot', 1) AS snapshot_stale,
       bm25_debug_segcat_walk('sc_bm', 'segcat_read',   1) AS read_stale,
       bm25_debug_segcat_walk('sc_bm', 'find_entry',    1) AS find_stale,
       bm25_debug_segcat_walk('sc_bm', 'locate_entry',  1) AS locate_stale,
       bm25_debug_segcat_walk('sc_bm', 'first_entry',   1) AS first_stale;
 snapshot_stale | read_stale | find_stale | locate_stale | first_stale 
----------------+------------+------------+--------------+-------------
            210 |        210 |          1 |            1 |           1
(1 row)

SELECT bm25_debug_segcat_walk('sc_bm', 'scan_snapshot', 0) AS snapshot_stale_0,
       bm25_debug_segcat_walk('sc_bm', 'locate_entry',  0) AS locate_stale_0,
       bm25_debug_segcat_walk('sc_bm', 'first_entry',   0) AS first_stale_0;
 snapshot_stale_0 | locate_stale_0 | first_stale_0 
------------------+----------------+---------------
              210 |              1 |             1
(1 row)

-- The lever validates its arguments (97_debug_probe_arguments' rule), and so does the
-- probe.
\set VERBOSITY terse
SELECT bm25_debug_stamp_chain_next('sc_bm', 'nosuch', -1, 0, 1);
ERROR:  bm25_debug_stamp_chain_next: unknown chain "nosuch"
SELECT bm25_debug_stamp_chain_next('sc_bm', 'segcat', 0, 0, 1);
ERROR:  bm25_debug_stamp_chain_next: seg must be -1 for chain segcat
SELECT bm25_debug_stamp_chain_next('sc_bm', 'segcat', -1, -1, 1);
ERROR:  bm25_debug_stamp_chain_next: page -1 is negative
SELECT bm25_debug_stamp_chain_next('sc_bm', 'segcat', -1, 0, -1);
ERROR:  bm25_debug_stamp_chain_next: nextblk -1 is not a block number
SELECT bm25_debug_stamp_chain_next('sc_bm', 'segcat', -1, 0, 4294967296);
ERROR:  bm25_debug_stamp_chain_next: nextblk 4294967296 is not a block number
SELECT bm25_debug_stamp_chain_next('sc_bm', 'segcat', -1, 2, 1);
ERROR:  bm25_debug_stamp_chain_next: segcat chain has only 2 page(s)
SELECT bm25_debug_segcat_walk('sc_bm', 'nosuch', -1);
ERROR:  bm25_debug_segcat_walk: unknown walker "nosuch"
SELECT bm25_debug_segcat_walk('sc_bm', 'segcat_read', -2);
ERROR:  bm25_debug_segcat_walk: nblocks -2 is not a block count
SELECT bm25_debug_segcat_walk('sc_bm', 'segcat_read', 4294967296);
ERROR:  bm25_debug_segcat_walk: nblocks 4294967296 is not a block count
\set VERBOSITY default
-- Now a real corrupt link: the ROOT page's nextblk, i.e. the link from the 7-entry
-- page to the full one. 4294967294 is one below InvalidBlockNumber -- the largest value
-- that is still a block number, so nothing that tests for InvalidBlockNumber can
-- answer instead of the extent bound. The lever returns the block it stamped; only
-- its being a real block matters here.
SELECT bm25_debug_stamp_chain_next('sc_bm', 'segcat', -1, 0, 4294967294) > 0
       AS stamped_root_page;
 stamped_root_page 
-------------------
