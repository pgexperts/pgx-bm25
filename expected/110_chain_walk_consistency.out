-- One past the last real page: the smallest rejected value.
SELECT bm25_debug_stamp_chain_next('kf_bm', 'keymap', 0, 0, bm25_debug_npages('kf_bm')) > 0
       AS stamped_keymap_one_past_end;
 stamped_keymap_one_past_end 
