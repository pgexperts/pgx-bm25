(1 row)

-- A stale sample must not mask real corruption: the re-sample raises the bound again.
SELECT pg_temp.err_of($q$SELECT bm25_debug_segcat_walk('sc_bm', 'scan_snapshot', 1)$q$)
       AS snapshot_stale_past_extent;
             snapshot_stale_past_extent             
----------------------------------------------------
 XX002 bm25: segment catalog chain leaves the index
(1 row)

-- One past the last real page: the smallest rejected value, which shows the bound is
-- `>=` against the live extent rather than a comparison with some constant.
SELECT bm25_debug_stamp_chain_next('sc_bm', 'segcat', -1, 0, bm25_debug_npages('sc_bm')) > 0
       AS stamped_one_past_end;
 stamped_one_past_end 
----------------------
