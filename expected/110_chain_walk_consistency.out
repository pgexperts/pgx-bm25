RESET enable_seqscan;
-- The lever leaves the catalog permanently corrupt by construction.
DROP TABLE sc_docs;
-- ======================================= 3. bm25_debug_postings' per-posting NORMS walk
-- dbg_post_cb, bm25_debug_postings' per-posting callback, read each posting's doclen
-- through the one-shot bm25_seg_doclen: a NORMS walk from the ROOT plus one
-- RelationGetNumberOfBlocks per posting -- the cost ADR 0095 removed from every other
-- per-posting path by giving it a BM25SegReader. It now reads through a reader opened
-- once per segment, via the new bm25_seg_reader_doclen.
--
-- Three fields, so a NORMS row is 12 bytes and 6000 docs span nine NORMS pages; each
-- field's length is a different function of id, so a cell read from the wrong row or
-- the wrong field shows up as a wrong sum.
CREATE TABLE dl_docs (id int, a text, b text, c text);
INSERT INTO dl_docs
SELECT g, repeat('alpha ', g % 5 + 1), repeat('beta ', g % 7 + 1), repeat('gamma ', g % 11 + 1)
FROM generate_series(1, 6000) g;
CREATE INDEX dl_bm ON dl_docs USING bm25_native (a, b, c);
SELECT bm25_seal('dl_bm');
 bm25_seal 
-----------
 
(1 row)

-- The cost is the defect, and it is visible as buffer traffic. Each posting reads
-- field_count NORMS cells, and through a reader each cell is one page visit -- the page
-- the previous cell landed on -- plus a walk from the root only at each term's first
-- posting. The one-shot form walked from the root for EVERY posting, about half the
-- chain on average, so it came in well above the (field_count + 1) visits per posting
-- asserted here. The count covers the whole SRF, DICT and POST pages included, so a
-- ratio rather than an exact number: that keeps the assertion independent of BLCKSZ and
-- of how this build lays out a page.
CREATE FUNCTION pg_temp.postings_hits(idx text) RETURNS bigint AS $$
DECLARE
    plan json;
BEGIN
    EXECUTE format('EXPLAIN (ANALYZE, BUFFERS, FORMAT JSON) '
                   'SELECT count(*) FROM bm25_debug_postings(%L)', idx) INTO plan;
    RETURN (plan -> 0 -> 'Plan' ->> 'Shared Hit Blocks')::bigint
         + (plan -> 0 -> 'Plan' ->> 'Shared Read Blocks')::bigint;
END; $$ LANGUAGE plpgsql;
SELECT count(*) AS postings FROM bm25_debug_postings('dl_bm');
 postings 
----------
    18000
(1 row)

SELECT pg_temp.postings_hits('dl_bm')
         < (3 + 1) * (SELECT count(*) FROM bm25_debug_postings('dl_bm'))
       AS postings_pages_bounded_per_posting;
 postings_pages_bounded_per_posting 
------------------------------------
 t
(1 row)

-- Differential: bm25_seg_reader_doclen, carried across the whole docid list by ONE
-- reader, against bm25_seg_doclen called fresh for each docid (a root walk every time,
-- the pre-fix path), AND against the length computed from the row itself -- joined
-- through the doc's TID, so two readings that were wrong the same way would still
-- fail. Three orders: ascending is the converted caller's pattern; descending and a
-- hash-scattered order make the cursor jump backward, the branch where resuming from
-- a stale position would read the wrong cell.
CREATE FUNCTION pg_temp.doclen_diff(docids int[]) RETURNS TABLE
    (rows bigint, reader_eq_oneshot bigint, reader_eq_heap bigint) AS $$
    SELECT count(*),
           count(*) FILTER (WHERE r.reader_bytes = r.oneshot_bytes),
           count(*) FILTER (WHERE r.reader_int = (d.id % 5 + 1) + (d.id % 7 + 1)
                                                  + (d.id % 11 + 1))
    FROM bm25_debug_seg_reader_diff('dl_bm', 0, 'doclen', docids) r
    JOIN dl_docs d ON d.ctid = r.tid;
$$ LANGUAGE sql;
SELECT * FROM pg_temp.doclen_diff(ARRAY(SELECT generate_series(0, 5999)));
 rows | reader_eq_oneshot | reader_eq_heap 
------+-------------------+----------------
 6000 |              6000 |           6000
(1 row)

SELECT * FROM pg_temp.doclen_diff(ARRAY(SELECT generate_series(5999, 0, -1)));
 rows | reader_eq_oneshot | reader_eq_heap 
------+-------------------+----------------
 6000 |              6000 |           6000
(1 row)

SELECT * FROM pg_temp.doclen_diff(
    ARRAY(SELECT d FROM generate_series(0, 5999) d ORDER BY hashint4(d), d));
 rows | reader_eq_oneshot | reader_eq_heap 
------+-------------------+----------------
 6000 |              6000 |           6000
(1 row)

-- The SRF's own output agrees with the row: every posting's doclen is its document's
-- total length, whichever term it belongs to.
SELECT count(*) AS postings_with_wrong_doclen
FROM bm25_debug_postings('dl_bm') p
WHERE p.doclen NOT IN (SELECT (id % 5 + 1) + (id % 7 + 1) + (id % 11 + 1) FROM dl_docs);
