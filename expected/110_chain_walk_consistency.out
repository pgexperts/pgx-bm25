-- Documents on the first page never follow the corrupt link, so they still resolve:
-- the bound rejects the bad pointer, not the chain.
SELECT reader_int = oneshot_int AS first_page_key_agrees, reader_int AS first_page_key
  FROM bm25_debug_seg_reader_diff('kf_bm', 0, 'key', ARRAY[0]);
