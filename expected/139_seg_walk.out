-- 139_seg_walk -- BM25SegWalk, the validated page reader every sealed-chain walk reads
-- through (issue #303), and the order invariants that end a cycle in each chain family.
--
-- Every case forges one link or field on a real page and asserts the SQLSTATE the
-- walker raises. Post-fix every one is XX002 (ERRCODE_INDEX_CORRUPTED). Before the fix
-- the same corruption gave 40001 (a link to block 0 read the metapage and failed the
-- gen check as a "concurrent reclaim", which the ranking build retried three times), a
-- spin until statement_timeout (57014), or no error and a wrong answer. Each section
-- names what it gave pre-fix.
--
-- Pages are found by walking the real chains with the raw lever: bm25_debug_poke_page
-- returns the bytes it replaced, so poking a value and poking the returned bytes back
-- reads a field without changing it (pg_temp.peek). Offsets come from bm25_debug_layout,
-- and multi-byte values are encoded in the host's byte order, which is read off the
-- metapage first (pg_temp.le).
CREATE EXTENSION bm25_native;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
-- SQLSTATE beside the message. Numbers are stripped: block numbers and page counts
-- depend on the page layout, not on the check under test.
CREATE FUNCTION pg_temp.err_of(q text) RETURNS text AS $$
BEGIN
    EXECUTE q;
    RETURN 'NO ERROR RAISED';
EXCEPTION WHEN OTHERS THEN
    RETURN SQLSTATE || ' ' || regexp_replace(SQLERRM, '\m\d+\M', 'N', 'g');
END; $$ LANGUAGE plpgsql;
CREATE FUNCTION pg_temp.lay(s text, f text) RETURNS int AS $$
    SELECT off FROM bm25_debug_layout() WHERE struct = s AND field = f;
$$ LANGUAGE sql;
CREATE FUNCTION pg_temp.size(s text) RETURNS int AS $$
    SELECT size FROM bm25_debug_layout() WHERE struct = s AND field = '*';
$$ LANGUAGE sql;
CREATE FUNCTION pg_temp.special(f text) RETURNS int AS $$
    SELECT pg_temp.lay('page', 'special') + pg_temp.lay('BM25PageOpaque', f);
$$ LANGUAGE sql;
CREATE FUNCTION pg_temp.contents(s text, f text) RETURNS int AS $$
    SELECT pg_temp.lay('page', 'contents') + pg_temp.lay(s, f);
$$ LANGUAGE sql;
-- Read len bytes at (blk, off) without changing them: poke, then poke the old bytes back.
CREATE FUNCTION pg_temp.peek(idx regclass, blk bigint, off int, len int) RETURNS bytea AS $$
DECLARE old bytea;
BEGIN
    old := bm25_debug_poke_page(idx, blk, off, decode(repeat('ff', len), 'hex'));
    PERFORM bm25_debug_poke_page(idx, blk, off, old);
    RETURN old;
END; $$ LANGUAGE plpgsql;
-- Host byte order, from the metapage's opaque flags (BM25_PAGE_META, low byte nonzero).
CREATE TABLE bo (id int PRIMARY KEY, body text);
INSERT INTO bo VALUES (1, 'alpha');
CREATE INDEX bo_bm ON bo USING bm25_native (body);
CREATE TEMP TABLE host AS
SELECT get_byte(pg_temp.peek('bo_bm', 0, pg_temp.special('flags'), 2), 0)
         = (bm25_debug_page_flags('bo_bm', 0) & 255) AS le;
DROP TABLE bo;
CREATE FUNCTION pg_temp.u32(b bytea) RETURNS bigint AS $$
    SELECT CASE WHEN (SELECT le FROM host)
        THEN get_byte(b, 0)::bigint + (get_byte(b, 1)::bigint << 8) +
             (get_byte(b, 2)::bigint << 16) + (get_byte(b, 3)::bigint << 24)
        ELSE get_byte(b, 3)::bigint + (get_byte(b, 2)::bigint << 8) +
             (get_byte(b, 1)::bigint << 16) + (get_byte(b, 0)::bigint << 24) END;
$$ LANGUAGE sql;
CREATE FUNCTION pg_temp.b32(v bigint) RETURNS bytea AS $$
    SELECT CASE WHEN (SELECT le FROM host)
        THEN set_byte(set_byte(set_byte(set_byte('\x00000000'::bytea,
                 0, (v & 255)::int), 1, ((v >> 8) & 255)::int),
                 2, ((v >> 16) & 255)::int), 3, ((v >> 24) & 255)::int)
        ELSE set_byte(set_byte(set_byte(set_byte('\x00000000'::bytea,
                 3, (v & 255)::int), 2, ((v >> 8) & 255)::int),
                 1, ((v >> 16) & 255)::int), 0, ((v >> 24) & 255)::int) END;
$$ LANGUAGE sql;
CREATE FUNCTION pg_temp.b16(v int) RETURNS bytea AS $$
    SELECT CASE WHEN (SELECT le FROM host)
        THEN set_byte(set_byte('\x0000'::bytea, 0, v & 255), 1, (v >> 8) & 255)
        ELSE set_byte(set_byte('\x0000'::bytea, 1, v & 255), 0, (v >> 8) & 255) END;
$$ LANGUAGE sql;
CREATE FUNCTION pg_temp.u16(b bytea) RETURNS int AS $$
    SELECT CASE WHEN (SELECT le FROM host)
        THEN get_byte(b, 0) + (get_byte(b, 1) << 8)
        ELSE get_byte(b, 1) + (get_byte(b, 0) << 8) END;
$$ LANGUAGE sql;
-- A page's nextblk, and forging it (returns the old link).
CREATE FUNCTION pg_temp.next_of(idx regclass, blk bigint) RETURNS bigint AS $$
    SELECT pg_temp.u32(pg_temp.peek(idx, blk, pg_temp.special('nextblk'), 4));
$$ LANGUAGE sql;
CREATE FUNCTION pg_temp.set_next(idx regclass, blk bigint, nxt bigint) RETURNS bigint AS $$
    SELECT pg_temp.u32(bm25_debug_poke_page(idx, blk, pg_temp.special('nextblk'),
                                            pg_temp.b32(nxt)));
$$ LANGUAGE sql;
-- Segment n's header block, and a root field of its header.
CREATE FUNCTION pg_temp.seg_hdr(idx regclass, n int) RETURNS bigint AS $$
    SELECT pg_temp.u32(substring(bm25_debug_segcat_entry_bytes(idx, n)
                                 FROM pg_temp.lay('BM25SegCatEntry', 'header_blkno') + 1
                                 FOR 4));
$$ LANGUAGE sql;
CREATE FUNCTION pg_temp.seg_root(idx regclass, n int, f text) RETURNS bigint AS $$
    SELECT pg_temp.u32(pg_temp.peek(idx, pg_temp.seg_hdr(idx, n),
                                    pg_temp.contents('BM25SegmentHeader', f), 4));
$$ LANGUAGE sql;
-- The blocks of a chain, root first.
CREATE FUNCTION pg_temp.chain(idx regclass, root bigint) RETURNS bigint[] AS $$
DECLARE b bigint := root; out bigint[] := '{}';
BEGIN
    WHILE b <> 4294967295 AND cardinality(out) < 1000 LOOP
        out := out || b;
        b := pg_temp.next_of(idx, b);
    END LOOP;
    RETURN out;
END; $$ LANGUAGE plpgsql;
-- The fixture, rebuilt per case because every case leaves its index corrupt: 5000
-- keyed documents, one segment. 'common' is in every document and sorts first, so its
-- postings and position frames start on the first POST and POS pages and cross onto
-- the next; the norms, doc-map and keymap chains span three, four and three pages.
CREATE TABLE src AS
SELECT g AS id, 'common w' || g || repeat(' pad', g % 7) || ' zeta eta theta' AS body
  FROM generate_series(1, 5000) g;
CREATE FUNCTION pg_temp.mk(t text) RETURNS void AS $$
BEGIN
    EXECUTE format('DROP TABLE IF EXISTS %I', t);
    EXECUTE format('CREATE TABLE %I (id int PRIMARY KEY, body text)', t);
    EXECUTE format('INSERT INTO %I SELECT * FROM src', t);
    EXECUTE format('CREATE INDEX %I ON %I USING bm25_native (body) INCLUDE (id) '
                   'WITH (key_field = ''id'')', t || '_bm', t);
END; $$ LANGUAGE plpgsql;
-- Controls on a healthy copy: every reader the cases aim at answers in full, and the
-- chains are as long as the cases need.
SELECT pg_temp.mk('ok');
NOTICE:  table "ok" does not exist, skipping
 mk 
