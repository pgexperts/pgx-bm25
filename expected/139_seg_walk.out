RESET statement_timeout;
-- The merge feed over a DICT cycle (T4). Positions off, so the merge reads only the
-- dictionary and the postings: with positions the POS replay of the re-fed terms raised
-- a desync error first, which named the wrong chain. Four same-size segments, which the
-- merge picks up together. Before the fix the feed re-read the cycle's terms until
-- cancelled; now it stops at the cycle, and nothing is published.
CREATE TABLE d6 (id int PRIMARY KEY, body text) WITH (autovacuum_enabled = off);
CREATE INDEX d6_bm ON d6 USING bm25_native (body) WITH (store_positions_body = false);
CREATE FUNCTION pg_temp.four_segments(t text) RETURNS void AS $$
DECLARE i int;
BEGIN
    FOR i IN 0..3 LOOP
        EXECUTE format('INSERT INTO %I SELECT * FROM src WHERE id > %s AND id <= %s',
                       t, i * 1250, (i + 1) * 1250);
        PERFORM bm25_seal((t || '_bm')::regclass);
    END LOOP;
END; $$ LANGUAGE plpgsql;
