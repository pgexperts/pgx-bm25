-- ===================================================== 4. POST chains (ADR 0111 residuals)
-- A term's run is held to df postings (ADR 0111), which bounded a POST walk by its
-- postings but not by its pages: a cycle through pages holding no blocks spun, and a
-- link back to a block already decoded re-emitted it. Now every page entered mid-run
-- must yield a block, and (docid, field) must ascend across blocks.
CREATE FUNCTION pg_temp.posts(idx regclass) RETURNS bigint[] AS $$
    SELECT pg_temp.chain(idx, pg_temp.seg_root(idx, 0, 'posts_root'));
$$ LANGUAGE sql;
-- 'common' sorts first, so its run starts on the POST chain's first page and continues
-- onto the second.
SELECT array_agg(DISTINCT block_no ORDER BY block_no) = (pg_temp.posts('ok_bm'))[1:2]
       AS common_on_first_two_pages
  FROM bm25_debug_block_impacts('ok_bm', 'common');
 common_on_first_two_pages 
---------------------------
