-- ===================================================== 5. WAND: block order
-- 'even' is in every second document of 600, a run of three blocks on one POST page
-- (128, 128, 44 postings). The later documents are shorter, so they score higher and a
-- top-k must decode past the first block.
CREATE TABLE w7 (id int PRIMARY KEY, body text);
INSERT INTO w7 SELECT g, CASE WHEN g % 2 = 0 THEN 'even' ELSE 'odd' END ||
                         CASE WHEN g <= 260 THEN ' filler filler filler' ELSE '' END
  FROM generate_series(1, 600) g;
CREATE INDEX w7_bm ON w7 USING bm25_native (body);
SELECT block_ord, ndocs, first_docid > 127 AND first_docid < 16384 AS two_byte_first
  FROM bm25_debug_block_spans('w7_bm', 'even') ORDER BY block_ord;
 block_ord | ndocs | two_byte_first 
-----------+-------+----------------
         0 |   128 | f
         1 |   128 | t
         2 |    44 | t
(3 rows)

-- The healthy top 5, and the WAND build behind it, which decodes all three blocks.
SELECT array_agg(id ORDER BY id) AS top5 FROM
  (SELECT id FROM w7 WHERE body @@@ 'even' ORDER BY body &@@ 'even' LIMIT 5) s;
         top5          
-----------------------
 {262,264,266,268,270}
(1 row)

SELECT blocks_examined FROM bm25_wand_stats('w7_bm', 'even', 5);
 blocks_examined 
-----------------
               3
(1 row)

-- The second block's first docid is forged down below the first block's last, and its
-- second delta up by the same amount, keeping each varbyte its width: the header and
-- its last_docid still agree, so only the decoded first posting shows the step back.
-- Before the fix the WAND cursor decoded it and scored on, with no error.
CREATE TEMP TABLE w7_at AS
SELECT d.post_root, d.post_off,
       pg_temp.lay('page', 'contents') + d.post_off + pg_temp.size('BM25BlockHeader') +
       pg_temp.u16(pg_temp.peek('w7_bm', d.post_root, pg_temp.lay('page', 'contents') +
                                d.post_off + pg_temp.lay('BM25BlockHeader', f), 2)) AS x
  FROM (SELECT pg_temp.u32(pg_temp.peek('w7_bm', (pg_temp.dict('w7_bm'))[1],
                                        pg_temp.contents('BM25DictEntry', 'post_root'), 4))
               AS post_root,
               pg_temp.u16(pg_temp.peek('w7_bm', (pg_temp.dict('w7_bm'))[1],
                                        pg_temp.contents('BM25DictEntry', 'post_off'), 2))
               AS post_off) d,
       unnest(ARRAY['docid_bytes', 'tf_bytes', 'field_rle_bytes', 'impact_bytes']) f;
CREATE TEMP TABLE w7_blk2 AS
SELECT post_root, sum(x) - 3 * min(post_off) - 3 * (pg_temp.lay('page', 'contents') +
           pg_temp.size('BM25BlockHeader')) + pg_temp.size('BM25BlockHeader') AS docids_off
  FROM w7_at GROUP BY post_root;
CREATE TEMP TABLE w7_old AS
SELECT post_root, docids_off, pg_temp.peek('w7_bm', post_root, docids_off::int, 3) AS b
  FROM w7_blk2;
-- The old bytes are the second block's first docid (two varbyte bytes) and a one-byte
-- delta, as the spans above say.
SELECT (get_byte(b, 0) & 127) + (get_byte(b, 1) << 7)
         = (SELECT first_docid FROM bm25_debug_block_spans('w7_bm', 'even') WHERE block_ord = 1)
       AS first_docid_found,
       get_byte(b, 2) < 128 AS one_byte_delta
  FROM w7_old;
 first_docid_found | one_byte_delta 
-------------------+----------------
 t                 | t
(1 row)

CREATE TEMP TABLE w7_new AS
SELECT post_root, docids_off, b,
       (SELECT last_docid FROM bm25_debug_block_spans('w7_bm', 'even') WHERE block_ord = 0)
         - 10 AS f2,
       (get_byte(b, 0) & 127) + (get_byte(b, 1) << 7) AS f1
  FROM w7_old;
SELECT bm25_debug_poke_page('w7_bm', post_root, docids_off::int,
           set_byte(set_byte(set_byte('\x000000'::bytea,
               0, ((f2 & 127) | 128)::int), 1, (f2 >> 7)::int),
               2, (get_byte(b, 2) + f1 - f2)::int)) = b AS forged
  FROM w7_new;
 forged 
--------
 t
(1 row)

