-- A cycle through two pages emptied of entries (pd_lower back to the page header). The
-- order rule has nothing to compare on an empty page, so before the empty-page rule
-- this ran to the walker's cap; before the walker, it spun.
-- The lever refuses a pd_lower lowered over live bytes (Generic WAL would zero them),
-- so each page is emptied in three pokes, returning its old pd_lower: raise pd_lower to
-- pd_special, which a page with no line pointers has as pd_upper, so there is no hole
-- and the old value comes back; zero the entries, [contents, old pd_lower); then lower
-- pd_lower to contents over what is now an all-zero hole.
CREATE FUNCTION pg_temp.empty_page(idx regclass, blk bigint) RETURNS int AS $$
DECLARE
    lower_off int := pg_temp.lay('PageHeaderData', 'pd_lower');
    contents  int := pg_temp.lay('page', 'contents');
    old_lower int;
BEGIN
    old_lower := pg_temp.u16(bm25_debug_poke_page(idx, blk, lower_off,
                                                  pg_temp.b16(pg_temp.lay('page', 'special'))));
    IF old_lower > contents THEN
        PERFORM bm25_debug_poke_page(idx, blk, contents,
                                     decode(repeat('00', old_lower - contents), 'hex'));
    END IF;
    PERFORM bm25_debug_poke_page(idx, blk, lower_off, pg_temp.b16(contents));
    RETURN old_lower;
END; $$ LANGUAGE plpgsql;
