-- ===================================================== 3. DICT chains (303.A a, e)
-- The dictionary is sorted across its pages, every page holds an entry, and the chain
-- holds the header's nterms entries; those rules are what end a cycle here. Before
-- them the DICT walkers bounded only the extent, so an in-extent cycle spun until
-- cancelled: the lookup and the wildcard expander for a term sorting after every entry
-- on the cycle, and the three dumps always. 'zzzz' sorts after every term.
CREATE FUNCTION pg_temp.dict(idx regclass) RETURNS bigint[] AS $$
    SELECT pg_temp.chain(idx, pg_temp.seg_root(idx, 0, 'dict_root'));
$$ LANGUAGE sql;
SELECT cardinality(pg_temp.dict('ok_bm')) >= 10 AS ten_or_more_dict_pages;
 ten_or_more_dict_pages 
