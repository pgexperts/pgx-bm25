-- ===================================================== 6. a link into another segment
-- Every segment chain carries its segment's gen, so a link into another segment's page
-- of the same kind failed the gen check -- which read every mismatch as a concurrent
-- reclaim: 40001, retried three times by the ranking build and retryable forever by a
-- client. A segment still in the live catalog cannot have had a page reclaimed, so the
-- mismatch is now told apart by the catalog, read under the metapage lock: XX002 when
-- the walk's own segment is live, 40001 only when it has left the catalog (the standby
-- race). That 40001 branch is not driven by any test: the segment scan path has no
-- pause point to park a walk across a merge + reclaim, and a standby TAP for it was
-- judged M-cost (t/025 covers the pending-list epoch 40001, a different arm).
CREATE FUNCTION pg_temp.seg_of(idx regclass, docs bigint) RETURNS int AS $$
    SELECT (n - 1)::int FROM bm25_debug_segcat(idx) WITH ORDINALITY
                           AS t(ndocs, live_ndocs, total_len, nterms, has_pos, tokens, n)
     WHERE ndocs = docs;
$$ LANGUAGE sql;
CREATE FUNCTION pg_temp.mk2(t text) RETURNS void AS $$
BEGIN
    PERFORM pg_temp.mk(t);
    EXECUTE format('INSERT INTO %I SELECT g, ''common late'' FROM generate_series(9001, 9010) g',
                   t);
    PERFORM bm25_seal((t || '_bm')::regclass);
END; $$ LANGUAGE plpgsql;
-- NORMS: the big segment's first norms page linked to the small one's norms root.
SELECT pg_temp.mk2('g1');
