-- A header out of order, forged on the second block (its last_docid below the first
-- block's). A next_geq that bypasses such a block header-only never decodes it, so only
-- the header order can see it; the open-time sweep reads every header of the run and
-- now holds them in order, before any decode. This pins WHERE it is caught, not whether:
-- the probe's own linear control walk decodes the block, and before the fix that decode
-- refused it through the header's last_docid check. A query that bypasses the block
-- without decoding it needs pruning this small corpus does not produce.
CREATE TABLE w8 AS SELECT * FROM w7 WITH NO DATA;
ALTER TABLE w8 ADD PRIMARY KEY (id);
INSERT INTO w8 SELECT g, CASE WHEN g % 2 = 0 THEN 'even' ELSE 'odd' END ||
                         CASE WHEN g <= 260 THEN ' filler filler filler' ELSE '' END
  FROM generate_series(1, 600) g;
CREATE INDEX w8_bm ON w8 USING bm25_native (body);
SELECT bm25_debug_stamp_post_block('w8_bm', 0, 0, 1, 'last_docid', 100) > 0 AS stamped;
