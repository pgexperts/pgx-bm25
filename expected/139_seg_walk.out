RESET bm25_native.wand_top_k;
SELECT c AS chain, cardinality(pg_temp.chain('ok_bm', pg_temp.seg_root('ok_bm', 0, c))) >= 3
       AS three_or_more_pages
  FROM unnest(ARRAY['dict_root', 'posts_root', 'norms_root', 'docmap_root', 'keymap_root',
                    'pos_root']) c;
