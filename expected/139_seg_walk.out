-- LIVE, on VACUUM's write path (T13). bm25_livedocs_locate walks to the page holding a
-- document's bit and hands the link it ends on to bm25_livedocs_clear unread; it carried
-- no gen, and the clear checked only the page's kind. A big segment's first LIVE page
-- linked to a small segment's LIVE root therefore sent the tombstone for the big
-- segment's document 65152 (bit 0 of its second page) to bit 0 of the small segment:
-- the small segment's document 0 was deleted, with no error.
CREATE TABLE lv (id int PRIMARY KEY, body text);
INSERT INTO lv SELECT g, 'alpha' FROM generate_series(1, 66000) g;
CREATE INDEX lv_bm ON lv USING bm25_native (body);
INSERT INTO lv SELECT g, 'beta' FROM generate_series(70001, 70005) g;
SELECT bm25_seal('lv_bm');
