(1 row)

SELECT array_agg(id ORDER BY id) AS keyed_ids, bool_and(scored) AS every_key_scored
  FROM (SELECT id, bm25_score_key(id) > 0 AS scored
          FROM kk WHERE body @@@ 'alpha' ORDER BY body &@@ 'alpha' LIMIT 5) s;
